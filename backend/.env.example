# AuraHealth AI V2 - Backend Environment Configuration

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Voice AI Key (Optional for TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# JWT Authentication Secret Key
SECRET_KEY=aurahealth-super-secret-production-key-change-this

# CORS Allowed Origins (Comma-separated or * for wildcard)
ALLOWED_ORIGINS=https://aura-health-ai.vercel.app,http://localhost:5173,http://localhost:3000

# Access token duration in minutes (Default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
